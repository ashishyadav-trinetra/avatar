# ═══════════════════════════════════════════════
#  AI Avatar POC — Environment Configuration
#  Copy to .env and fill in your values
# ═══════════════════════════════════════════════

# ── LiveKit (REQUIRED) ───────────────────────────
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# ── OpenAI (REQUIRED for LLM + TTS) ─────────────
OPENAI_API_KEY=sk-...

# ── Avatar Engine ────────────────────────────────
# cuda  = NVIDIA GPU (required for real-time)
# cpu   = fallback, very slow (~2 FPS), POC/testing only
AVATAR_DEVICE=cuda
FPS_TARGET=25
FACE_SIZE=256

# ── Agent Configuration ──────────────────────────
STT_PROVIDER=deepgram        # deepgram | assemblyai | whisper
TTS_PROVIDER=openai          # openai | elevenlabs | cartesia
LLM_MODEL=gpt-4o-mini        # gpt-4o-mini | gpt-4o | claude-3-5-haiku

AGENT_SYSTEM_PROMPT=You are a helpful AI assistant. Be concise, warm, and conversational. Keep responses under 3 sentences when possible.

# ── Optional: ElevenLabs (better TTS voice) ──────
# ELEVENLABS_API_KEY=your_key
# ELEVENLABS_VOICE_ID=your_voice_id

# ── Optional: Deepgram (better STT) ─────────────
# DEEPGRAM_API_KEY=your_key

# ── Networking ───────────────────────────────────
STUN_SERVER=stun:stun.l.google.com:19302
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_WEBRTC_URL=http://localhost:8002

# ── Logging ──────────────────────────────────────
LOG_LEVEL=info
