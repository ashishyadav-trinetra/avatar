# ═══════════════════════════════════════════════════════════════
#  AI Avatar POC — PRODUCTION Environment
#  Copy to .env.prod and fill in your values
#  Used by: make prod / docker compose -f docker-compose.prod.yml
# ═══════════════════════════════════════════════════════════════

# ── LiveKit (REQUIRED) ───────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxx
LIVEKIT_API_SECRET=your_secret_here

# ── OpenAI (REQUIRED) ────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── Better STT (optional but recommended) ────────────────────
# Sign up: https://deepgram.com (free tier: 12,000 min/year)
DEEPGRAM_API_KEY=
STT_PROVIDER=deepgram

# ── Better TTS (optional but recommended) ────────────────────
# Sign up: https://elevenlabs.io (free tier: 10,000 chars/month)
# Voice ID: browse at https://elevenlabs.io/voice-lab
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
TTS_PROVIDER=openai

# ── LLM Model ────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini

# ── Avatar persona ───────────────────────────────────────────
AGENT_SYSTEM_PROMPT=You are a helpful AI assistant. Be concise, warm, and conversational. Keep responses under 3 sentences when possible.

# ── GPU / Performance ────────────────────────────────────────
AVATAR_DEVICE=cuda
FPS_TARGET=25
FACE_SIZE=256
BATCH_SIZE=4
ENABLE_UPSCALER=false

# ── Frontend URLs (update if deploying to a remote server) ───
# For local: keep as localhost
# For cloud GPU: replace with your server's public IP
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_WEBRTC_URL=http://localhost:8002

# ── Network ──────────────────────────────────────────────────
STUN_SERVER=stun:stun.l.google.com:19302

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
