FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY services/coefficient-engine/requirements.dev.txt .
RUN pip install --no-cache-dir -r requirements.dev.txt

# Install shared avatar-spec library
COPY libs/avatar_spec /tmp/avatar_spec
RUN pip install --no-cache-dir /tmp/avatar_spec || true

EXPOSE 8003

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8003", "--reload"]
